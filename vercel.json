{
  "redirects": [
    {
      "source": "/dj-qbit",
      "destination": "/vehrt",
      "permanent": true
    },
    {
      "source": "/compiler",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/javascript-compiler",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/project",
      "permanent": true
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/en(?:/.*)?", "status": 404, "dest": "/en/_404.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
