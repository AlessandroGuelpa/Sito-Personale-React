{
  "routes": [
    {
      "src": "/dj-qbit",
      "headers": { "Location": "/vehrt" },
      "status": 308
    },
    {
      "src": "/compiler",
      "headers": { "Location": "/" },
      "status": 308
    },
    {
      "src": "/javascript-compiler",
      "headers": { "Location": "/" },
      "status": 308
    },
    {
      "src": "/projects",
      "headers": { "Location": "/project" },
      "status": 308
    },
    { "handle": "error" },
    { "src": "/en(?:/.*)?", "status": 404, "dest": "/en/_404" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
